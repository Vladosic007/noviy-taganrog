# Переменные окружения для фронта (Vite build).
# Скопируйте в .env для локальной разработки или задайте в Vercel → Project Settings → Environment Variables.
#
# Локально:  cp .env.example .env

# Публичный URL бэкенда — куда фронт стучится за API и картинками.
# Локально: http://localhost:3001
# Прод (Railway): https://<ваш-проект>.up.railway.app  или ваш свой домен
VITE_API_HOST=http://localhost:3001
