# Переменные окружения бэкенда.
# Локально: cp .env.example .env
# На Render.com: задать в Environment → Add Environment Variable.

# --- Обязательно ---
# База данных. Для Neon используй строку из Console → Connection Details.
DATABASE_URL=postgresql://user:pass@localhost:5432/taganrog?schema=public

# --- CORS ---
# Домены фронта, которым разрешён доступ к API. Через запятую, без пробелов.
# Пример: https://noviy-taganrog.vercel.app,https://noviy-taganrog.ru
CORS_ORIGINS=http://localhost:5173

# --- Порт ---
# На Render/Fly переменная PORT задаётся автоматически — не трогай.
# PORT=3001
