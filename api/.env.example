# Переменные окружения бэкенда.
# Локально: cp .env.example .env
# На Railway: задать в Project → Variables (Railway автоматически подставит DATABASE_URL,
# если добавить в проект Postgres-плагин).

# --- Обязательно ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/taganrog?schema=public
PORT=3001

# --- CORS ---
# Список разрешённых origin через запятую. В проде — домен фронта на Vercel.
# Пример: https://noviy-taganrog.vercel.app,https://noviy-taganrog.ru
CORS_ORIGINS=http://localhost:5173

# --- ВКонтакте (для фазы 5) ---
VK_APP_ID=
VK_APP_SECRET=
VK_SUPERADMIN_ID=
